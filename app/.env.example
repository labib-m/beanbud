# Copy to .env.local for local work; set the same names in Vercel.
# Use the ANON (public) key only. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The PUBLIC half of the push notification key pair (see README's "Push notifications"
# section for how to generate it). Safe to share; it is not a secret.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google Maps Embed API key (see README's "Embedded maps" section). Optional: without it,
# cafe pages just skip the map and keep the "Open in Maps" link.
VITE_GOOGLE_MAPS_EMBED_KEY=your-google-maps-embed-key
